# Smart Research Web Scraper — optional configuration.
#
# The application runs fully with the deterministic local core and NO keys.
# Copy this file to .env and fill in only what you intend to use.
#
# This file is generated from src/scraper_app/credentials.py.
# Run `python scripts/sync_env_example.py` after adding a provider.

# ====================================================================
# AI model
# ====================================================================
# Anthropic Claude — https://docs.anthropic.com/en/api/getting-started
ANTHROPIC_API_KEY=
# OpenAI — https://platform.openai.com/docs/api-reference
OPENAI_API_KEY=
# Google Gemini — https://ai.google.dev/gemini-api/docs
GOOGLE_API_KEY=
# LiteLLM: Routes to whichever backend key above is set.

# ====================================================================
# Extraction engine
# ====================================================================
# Firecrawl — https://github.com/firecrawl/firecrawl
FIRECRAWL_API_KEY=
# ScrapeGraphAI — https://github.com/ScrapeGraphAI/scrapegraph-py
SGAI_API_KEY=
# AgentQL: Used through the REST API; the SDK is optional.
AGENTQL_API_KEY=

# ====================================================================
# Remote browser
# ====================================================================
# Browserbase — https://docs.browserbase.com/
BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=        (optional)
# Hyperbrowser — https://docs.hyperbrowser.ai/
HYPERBROWSER_API_KEY=
# Steel — https://docs.steel.dev/
STEEL_API_KEY=
# STEEL_BASE_URL=        (optional)
# Browserless: BROWSERLESS_URL points at a self-hosted instance.
BROWSERLESS_TOKEN=
# BROWSERLESS_URL=        (optional)

# ====================================================================
# Managed fetch
# ====================================================================
# ZenRows — https://docs.zenrows.com/
ZENROWS_API_KEY=
# ScrapingBee — https://www.scrapingbee.com/documentation/
SCRAPINGBEE_API_KEY=
# ScraperAPI — https://docs.scraperapi.com/
SCRAPERAPI_KEY=
# ScrapingAnt — https://docs.scrapingant.com/
SCRAPINGANT_API_KEY=
# Scrapfly — https://scrapfly.io/docs/scrape-api/getting-started
SCRAPFLY_API_KEY=
# Oxylabs — https://developers.oxylabs.io/scraper-apis/web-scraper-api
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
# Bright Data: BRIGHTDATA_ZONE names the Web Unlocker zone.
BRIGHTDATA_API_TOKEN=
# BRIGHTDATA_ZONE=        (optional)
# Scrapeless — https://docs.scrapeless.com/
SCRAPELESS_API_KEY=
# Nimble — https://docs.nimbleway.com/
NIMBLE_API_KEY=
# Thordata — https://www.thordata.com/documentation/
THORDATA_API_KEY=
# THORDATA_ENDPOINT=        (optional)

# ====================================================================
# Source discovery
# ====================================================================
# Tavily — https://docs.tavily.com/
TAVILY_API_KEY=
# Exa — https://exa.ai/docs/
EXA_API_KEY=
# Jina Search — https://jina.ai/reader/
JINA_API_KEY=

# ====================================================================
# Semantic content
# ====================================================================
# Diffbot — https://docs.diffbot.com/
DIFFBOT_TOKEN=
# Jina Reader — https://jina.ai/reader/
JINA_API_KEY=

# ====================================================================
# Agentic
# ====================================================================
# Skyvern — https://github.com/Skyvern-AI/skyvern
SKYVERN_API_KEY=
# SKYVERN_BASE_URL=        (optional)
# SKYVERN_ENGINE=        (optional)
# Stagehand: Needs a model key plus BROWSERBASE_API_KEY for hosted sessions.
# MODEL_API_KEY=        (optional)
# Browser Use: Needs one of the AI model keys above.

# ====================================================================
# Application behaviour — every value has a safe default
# ====================================================================
# User agent sent with every request
# SRWS_USER_AGENT=
# Per-host request rate  (default: 1.5)
# SRWS_REQUESTS_PER_SECOND=
# Parallel requests per host  (default: 2)
# SRWS_CONCURRENCY_PER_HOST=
# Retries before a request gives up  (default: 3)
# SRWS_MAX_RETRIES=
# Default page limit for a crawl  (default: 50)
# SRWS_MAX_CRAWL_PAGES=
# Absolute page ceiling  (default: 2000)
# SRWS_HARD_MAX_PAGES=
# Row ceiling for one dataset  (default: 500000)
# SRWS_MAX_ROWS=
# Rows rendered in the table view  (default: 1000)
# SRWS_MAX_PREVIEW_ROWS=
# Largest HTML response read  (default: 20971520)
# SRWS_MAX_HTML_BYTES=
# Largest JSON sample during discovery  (default: 2097152)
# SRWS_MAX_JSON_SAMPLE_BYTES=
# Largest file download  (default: 209715200)
# SRWS_MAX_DOWNLOAD_BYTES=
# HTTP timeout in seconds  (default: 30)
# SRWS_HTTP_TIMEOUT=
# Browser timeout in seconds  (default: 45)
# SRWS_BROWSER_TIMEOUT=
# Redirect hops allowed  (default: 5)
# SRWS_MAX_REDIRECTS=
# Scroll/click cycles for infinite lists  (default: 25)
# SRWS_MAX_SCROLLS=
# Where run artifacts are written  (default: runs/)
# SRWS_RUNS_DIR=
# Where caches are written  (default: .cache/)
# SRWS_CACHE_DIR=
# DANGEROUS: lets the guard reach private addresses. Tests and the offline demo only  (default: false)
# SRWS_ALLOW_PRIVATE_NETWORKS=
# Override the Anthropic model  (default: claude-sonnet-5)
# SRWS_ANTHROPIC_MODEL=
# Override the OpenAI model  (default: gpt-4o-mini)
# SRWS_OPENAI_MODEL=
# Override the Gemini model  (default: gemini-3.7-flash)
# SRWS_GOOGLE_MODEL=
# Override the LiteLLM model string  (default: gpt-4o-mini)
# SRWS_LITELLM_MODEL=
