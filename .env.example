# Smart Research Web Scraper — optional credentials.
# The application runs fully with the deterministic local core and NO keys.
# Copy to .env and fill in only what you intend to use.

# =========================
# AI model providers
# =========================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# =========================
# Scraping providers
# =========================
FIRECRAWL_API_KEY=
SGAI_API_KEY=
AGENTQL_API_KEY=

# =========================
# Browser/agent providers
# =========================
BROWSER_USE_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
SKYVERN_API_KEY=

# =========================
# Optional managed scraping
# =========================
APIFY_API_TOKEN=
ZYTE_API_KEY=

# =========================
# Application behaviour (optional overrides)
# =========================
SRWS_MAX_HTML_BYTES=
SRWS_MAX_CRAWL_PAGES=
SRWS_REQUESTS_PER_SECOND=
SRWS_USER_AGENT=
SRWS_ALLOW_PRIVATE_NETWORKS=false
